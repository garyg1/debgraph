            <node id="557" label="python3-idna">
                <attvalues>
                    <attvalue for="0" value="Python IDNA2008 (RFC 5891) handling (Python 3)" />
                    <attvalue for="1" value="[]" />
                    <attvalue for="2" value="Python IDNA2008 (RFC 5891) handling (Python 3)&#10; A library to support the Internationalised Domain Names in Applications (IDNA)&#10; protocol as specified in RFC 5891. This version of the protocol is often&#10; referred to as “IDNA2008” and can produce different results from the earlier&#10; standard from 2003.&#10; .&#10; The library is also intended to act as a suitable drop-in replacement for the&#10; “encodings.idna” module that comes with the Python standard library but&#10; currently only supports the older 2003 specification.&#10; .&#10; This package contains the module for Python 3." />
                    <attvalue for="3" value="[]" />
                    <attvalue for="4" value="372" />
                    <attvalue for="5" value="no" />
                    <attvalue for="6" value="Ubuntu Developers &lt;ubuntu-devel-discuss@lists.ubuntu.com&gt;" />
