            <node id="418" label="libuuid1:amd64">
                <attvalues>
                    <attvalue for="0" value="Universally Unique ID library" />
                    <attvalue for="1" value='[[{"name": "libuuid1t64", "op": "&lt;&lt;", "version": "2.41.3-3ubuntu2"}]]' />
                    <attvalue for="2" value="Universally Unique ID library&#10; The libuuid library generates and parses 128-bit Universally Unique&#10; IDs (UUIDs). A UUID is an identifier that is unique within the space&#10; of all such identifiers across both space and time. It can be used for&#10; multiple purposes, from tagging objects with an extremely short lifetime&#10; to reliably identifying very persistent objects across a network.&#10; .&#10; See RFC 4122 for more information." />
                    <attvalue for="3" value="[]" />
                    <attvalue for="4" value="90" />
                    <attvalue for="5" value="no" />
