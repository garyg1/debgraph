            <node id="106" label="gir1.2-packagekitglib-1.0">
                <attvalues>
                    <attvalue for="0" value="GObject introspection data for the PackageKit GLib library" />
                    <attvalue for="1" value="[]" />
                    <attvalue for="2" value="GObject introspection data for the PackageKit GLib library&#10; PackageKit allows performing simple software management tasks over a DBus&#10; interface e.g. refreshing the cache, updating, installing and removing&#10; software packages or searching for multimedia codecs and file handlers.&#10; .&#10; This package contains introspection data for the PackageKit&#10; GLib interface library.&#10; .&#10; It can be used by packages using the GIRepository format to generate&#10; dynamic bindings." />
                    <attvalue for="3" value="[]" />
                    <attvalue for="4" value="110" />
