                    <attvalue for="14" value='[[{"name": "python-blinker-doc", "op": null, "version": null}]]' />
                    <attvalue for="15" value="1.9.0-2build1" />
                </attvalues>
                </node>
            <node id="538" label="python3-certifi">
                <attvalues>
                    <attvalue for="0" value="root certificates for validating SSL certs and verifying TLS hosts (python3)" />
                    <attvalue for="1" value="[]" />
                    <attvalue for="2" value="root certificates for validating SSL certs and verifying TLS hosts (python3)&#10; Certifi is a carefully curated collection of Root Certificates for&#10; validating the trustworthiness of SSL certificates while verifying&#10; the identity of TLS hosts. It has been extracted from the Requests&#10; project.&#10; .&#10; The version of certifi in this Debian package is patched to return&#10; the location of Debian-provided CA certificates, instead of those&#10; packaged by upstream.&#10; .&#10; This is the python3 package." />
                    <attvalue for="3" value="[]" />
                    <attvalue for="4" value="42" />
