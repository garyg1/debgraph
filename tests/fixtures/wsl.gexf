            <node id="669" label="sysvinit-utils">
                <attvalues>
                    <attvalue for="0" value="System-V-like utilities" />
                    <attvalue for="1" value="[]" />
                    <attvalue for="2" value="System-V-like utilities&#10; This package contains the important System-V-like utilities.&#10; .&#10; Specifically, this package includes:&#10; init-d-script, fstab-decode, killall5, pidof&#10; .&#10; It also contains the library scripts sourced by init-d-script and other&#10; initscripts that were formerly in lsb-base." />
                    <attvalue for="3" value="[]" />
