            <node id="125" label="gtk-update-icon-cache">
                <attvalues>
                    <attvalue for="0" value="icon theme caching utility" />
                    <attvalue for="1" value='[[{"name": "libgtk-4-bin", "op": "&lt;&lt;", "version": "4.15"}]]' />
                    <attvalue for="2" value="icon theme caching utility&#10; gtk-update-icon-cache creates mmap()able cache files for icon themes.&#10; .&#10; GTK can use the cache files created by gtk-update-icon-cache to avoid a lot&#10; of system call and disk seek overhead when the application starts. Since the&#10; format of the cache files allows them to be mmap()ed shared between multiple&#10; applications, the overall memory consumption is reduced as well." />
                    <attvalue for="3" value="[]" />
                    <attvalue for="4" value="108" />
