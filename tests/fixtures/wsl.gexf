            <node id="323" label="liblzma5:amd64">
                <attvalues>
                    <attvalue for="0" value="XZ-format compression library" />
                    <attvalue for="1" value='[[{"name": "liblzma2", "op": "&lt;&lt;", "version": "5.1.1alpha+20110809-3~"}]]' />
                    <attvalue for="2" value="XZ-format compression library&#10; XZ is the successor to the Lempel-Ziv/Markov-chain Algorithm&#10; compression format, which provides memory-hungry but powerful&#10; compression (often better than bzip2) and fast, easy decompression.&#10; .&#10; The native format of liblzma is XZ; it also supports raw (headerless)&#10; streams and the older LZMA format used by lzma. (For 7-Zip's related&#10; format, use the p7zip package instead.)" />
                    <attvalue for="3" value="[]" />
                    <attvalue for="4" value="473" />
                    <attvalue for="5" value="no" />
