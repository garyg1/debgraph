            <node id="7" label="apport-core-dump-handler">
                <attvalues>
                    <attvalue for="0" value="Kernel core dump handler for Apport" />
                    <attvalue for="1" value='[[{"name": "apport", "op": "&lt;&lt;", "version": "2.27.0-0ubuntu7~"}]]' />
                    <attvalue for="2" value="Kernel core dump handler for Apport&#10; apport automatically collects data from crashed processes and&#10; compiles a problem report in /var/crash/. This utilizes the crashdump&#10; helper hook provided by the Ubuntu kernel.&#10; .&#10; This package provides the service that configures the kernel (via&#10; /proc/sys/kernel/core_pattern) to forward the crash dumps to apport." />
                    <attvalue for="3" value="[]" />
                    <attvalue for="4" value="28" />
                    <attvalue for="5" value="no" />
                    <attvalue for="6" value="Ubuntu Developers &lt;ubuntu-devel-discuss@lists.ubuntu.com&gt;" />
