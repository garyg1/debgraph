            <node id="601" label="python3-pyasn1">
                <attvalues>
                    <attvalue for="0" value="ASN.1 library for Python (Python 3 module)" />
                    <attvalue for="1" value="[]" />
                    <attvalue for="2" value="ASN.1 library for Python (Python 3 module)&#10; This  is  an implementation  of  ASN.1  types  and codecs  in  Python&#10; programming language. It has been first written to support particular&#10; protocol (SNMP) but then generalized  to be suitable for a wide range&#10; of protocols based on ASN.1 specification.&#10; .&#10; This package contains the Python 3 module." />
                    <attvalue for="3" value="[]" />
