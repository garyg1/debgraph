                    <attvalue for="14" value='[[{"name": "python-jsonschema-doc", "op": null, "version": null}], [{"name": "python3-fqdn", "op": null, "version": null}], [{"name": "python3-isoduration", "op": null, "version": null}], [{"name": "python3-rfc3339-validator", "op": null, "version": null}], [{"name": "python3-rfc3986-validator", "op": null, "version": null}], [{"name": "python3-rfc3987", "op": null, "version": null}], [{"name": "python3-uritemplate", "op": null, "version": null}], [{"name": "python3-webcolors", "op": null, "version": null}]]' />
