                    <attvalue for="13" value="3.3.2-2" />
                    <attvalue for="14" value='[[{"name": "python-pyparsing-doc", "op": null, "version": null}]]' />
                    <attvalue for="15" value="3.3.2-2" />
                </attvalues>
                </node>
