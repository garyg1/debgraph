            <node id="553" label="python3-gi">
                <attvalues>
                    <attvalue for="0" value="Python 3 bindings for gobject-introspection libraries" />
                    <attvalue for="1" value='[[{"name": "autoradio", "op": "&lt;&lt;", "version": "3.6.4-1.1~"}], [{"name": "blueprint-compiler", "op": "&lt;&lt;", "version": "0.16.0"}], [{"name": "budgie-desktop", "op": "&lt;&lt;", "version": "10.9.3-1.1~"}], [{"name": "entangle", "op": "&lt;&lt;", "version": "3.0-5.1~"}], [{"name": "eog", "op": "&lt;&lt;", "version": "47.0-4~"}], [{"name": "eom", "op": "&lt;&lt;", "version": "1.28.0-1.1~"}], [{"name": "exaile", "op": "&lt;&lt;", "version": "4.1.4"}], [{"name": "gedit", "op": "&lt;&lt;", "version": "48.1-8~"}], [{"name": "gir1.2-peas-1.0", "op": "&lt;&lt;", "version": "1.36.0-6~"}], [{"name": "gnome-music", "op": "&lt;&lt;", "version": "48.0"}], [{"name": "liferea", "op": "&lt;&lt;", "version": "1.16.1+ds-2.1~"}], [{"name": "pluma", "op": "&lt;&lt;", "version": "1.28.0-1.1~"}], [{"name": "rednotebook", "op": "&lt;&lt;", "version": "2.39"}], [{"name": "rhythmbox", "op": "&lt;&lt;", "version": "3.4.9-2~"}], [{"name": "streamtuner2", "op": "&lt;&lt;", "version": "2.2.2+dfsg-2.3~"}], [{"name": "totem", "op": "&lt;&lt;", "version": "43.2-7~"}]]' />
                    <attvalue for="2" value="Python 3 bindings for gobject-introspection libraries&#10; GObject is an abstraction layer that allows programming with an object&#10; paradigm that is compatible with many languages. It is a part of Glib,&#10; the core library used to build GTK+ and GNOME.&#10; .&#10; This package contains the Python 3 binding generator for libraries that&#10; support gobject-introspection, i. e. which ship a gir1.2-&lt;name&gt;-&lt;version&gt;&#10; package. With these packages, the libraries can be used from Python 3." />
                    <attvalue for="3" value="[]" />
                    <attvalue for="4" value="757" />
                    <attvalue for="5" value="no" />
