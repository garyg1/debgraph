            <node id="627" label="python3-typeguard">
                <attvalues>
                    <attvalue for="0" value="Run-time type checker for Python" />
                    <attvalue for="1" value="[]" />
                    <attvalue for="2" value="Run-time type checker for Python&#10; This library provides run-time type checking for functions defined with&#10; argument type annotations. This can be done in one of three ways:&#10;  * calling check_argument_types() from within the function body&#10;  * decorating the function with @typechecked&#10;  * using `with TypeChecker('packagename')`&#10; .&#10; This package installs the library for Python 3." />
                    <attvalue for="3" value="[]" />
                    <attvalue for="4" value="165" />
