            <node id="229" label="libext2fs2t64:amd64">
                <attvalues>
                    <attvalue for="0" value="ext2/ext3/ext4 file system libraries" />
                    <attvalue for="1" value='[[{"name": "e2fslibs", "op": "&lt;&lt;", "version": "1.43.9-1~"}], [{"name": "libext2fs2", "op": "&lt;&lt;", "version": "1.47.2-3ubuntu4"}]]' />
                    <attvalue for="2" value='ext2/ext3/ext4 file system libraries&#10; The ext2, ext3 and ext4 file systems are successors of the original ext&#10; ("extended") file system. They are the main file system types used for&#10; hard disks on Debian and other Linux systems.&#10; .&#10; This package provides the ext2fs and e2p libraries, for userspace software&#10; that directly accesses extended file systems. Programs that use libext2fs&#10; include e2fsck, mke2fs, and tune2fs. Programs that use libe2p include&#10; dumpe2fs, chattr, and lsattr.' />
                    <attvalue for="3" value="[]" />
                    <attvalue for="4" value="551" />
                    <attvalue for="5" value="no" />
