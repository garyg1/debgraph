            <node id="447" label="libxi6:amd64">
                <attvalues>
                    <attvalue for="0" value="X11 Input extension library" />
                    <attvalue for="1" value="[]" />
                    <attvalue for="2" value="X11 Input extension library&#10; libXi provides an X Window System client interface to the XINPUT&#10; extension to the X protocol.&#10; .&#10; The Input extension allows setup and configuration of multiple input devices,&#10; and hotplugging of input devices (to be added and removed on the fly).&#10; .&#10; More information about X.Org can be found at:&#10; &lt;URL:https://www.X.org&gt;&#10; .&#10; This module can be found at&#10; git://anongit.freedesktop.org/git/xorg/lib/libXi" />
                    <attvalue for="3" value="[]" />
                    <attvalue for="4" value="99" />
