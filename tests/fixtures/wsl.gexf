            <node id="333" label="libnetplan1:amd64">
                <attvalues>
                    <attvalue for="0" value="Declarative network configuration runtime library" />
                    <attvalue for="1" value="[]" />
                    <attvalue for="2" value="Declarative network configuration runtime library&#10; Netplan reads YAML network configuration files which are written&#10; by administrators, installers, cloud image instantiations, or other OS&#10; deployments. During early boot it then generates backend specific&#10; configuration files in /run to hand off control of devices to a particular&#10; networking daemon.&#10; .&#10; Currently supported backends are networkd and NetworkManager.&#10; .&#10; This package contains the necessary runtime library files." />
                    <attvalue for="3" value="[]" />
                    <attvalue for="4" value="383" />
                    <attvalue for="5" value="no" />
                    <attvalue for="6" value="Ubuntu Developers &lt;ubuntu-devel-discuss@lists.ubuntu.com&gt;" />
