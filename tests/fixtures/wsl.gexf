                    <attvalue for="11" value="libs" />
                    <attvalue for="12" value="libxcursor" />
                    <attvalue for="13" value="1:1.2.3-1build1" />
                    <attvalue for="14" value="[]" />
                    <attvalue for="15" value="1:1.2.3-1build1" />
                </attvalues>
                </node>
