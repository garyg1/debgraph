            <node id="446" label="libxft2:amd64">
                <attvalues>
                    <attvalue for="0" value="FreeType-based font drawing library for X" />
                    <attvalue for="1" value="[]" />
                    <attvalue for="2" value="FreeType-based font drawing library for X&#10; Xft provides a client-side font API for X applications, making the FreeType&#10; font rasterizer available to X clients.  Fontconfig is used for font&#10; specification resolution.  Where available, the RENDER extension handles&#10; glyph drawing; otherwise, the core X protocol is used." />
                    <attvalue for="3" value="[]" />
                    <attvalue for="4" value="118" />
                    <attvalue for="5" value="no" />
