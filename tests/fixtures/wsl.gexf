                    <attvalue for="0" value="Library for accessing PackageKit using GLib" />
                    <attvalue for="1" value="[]" />
                    <attvalue for="2" value='Library for accessing PackageKit using GLib&#10; PackageKit allows performing simple software management tasks over a DBus&#10; interface e.g. refreshing the cache, updating, installing and removing&#10; software packages or searching for multimedia codecs and file handlers.&#10; .&#10; This package provides an advanced library to access PackageKit using GLib.&#10; It makes use of only async D-Bus calls and provides high level tasks which&#10; peform the "transaction dance".' />
                    <attvalue for="3" value="[]" />
                    <attvalue for="4" value="437" />
