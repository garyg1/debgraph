            <node id="631" label="python3-urllib3">
                <attvalues>
                    <attvalue for="0" value="HTTP library with thread-safe connection pooling for Python3" />
                    <attvalue for="1" value="[]" />
                    <attvalue for="2" value="HTTP library with thread-safe connection pooling for Python3&#10; urllib3 supports features left out of urllib and urllib2 libraries.&#10; .&#10;   - Re-use the same socket connection for multiple requests (HTTPConnectionPool&#10;     and HTTPSConnectionPool) (with optional client-side certificate&#10;     verification).&#10;   - File posting (encode_multipart_formdata).&#10;   - Built-in redirection and retries (optional).&#10;   - Supports gzip and deflate decoding.&#10;   - Thread-safe and sanity-safe.&#10;   - Small and easy to understand codebase perfect for extending and&#10;     building upon." />
                    <attvalue for="3" value="[]" />
                    <attvalue for="4" value="485" />
                    <attvalue for="5" value="no" />
                    <attvalue for="6" value="Ubuntu Developers &lt;ubuntu-devel-discuss@lists.ubuntu.com&gt;" />
                    <attvalue for="7" value="" />
                    <attvalue for="8" value="[]" />
                    <attvalue for="9" value='[[{"name": "ca-certificates", "op": null, "version": null}]]' />
