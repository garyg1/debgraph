                    <attvalue for="13" value="2.4.8-4ubuntu3" />
                    <attvalue for="14" value='[[{"name": "gnupg", "op": "=", "version": "2.4.8-4ubuntu3"}], [{"name": "dbus-user-session", "op": null, "version": null}], [{"name": "libpam-systemd", "op": null, "version": null}], [{"name": "pinentry-gnome3", "op": null, "version": null}], [{"name": "scdaemon", "op": null, "version": null}], [{"name": "tpm2daemon", "op": null, "version": null}]]' />
                    <attvalue for="15" value="2.4.8-4ubuntu3" />
