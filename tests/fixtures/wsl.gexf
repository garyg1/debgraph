            <node id="321" label="libltdl7:amd64">
                <attvalues>
                    <attvalue for="0" value="System independent dlopen wrapper for GNU libtool" />
                    <attvalue for="1" value="[]" />
                    <attvalue for="2" value="System independent dlopen wrapper for GNU libtool&#10; This package contains the run-time libltdl library.&#10; .&#10; A small library that aims at hiding the various difficulties of&#10; dlopening libraries from programmers.  It is a system independent&#10; dlopen wrapper for GNU libtool.&#10; .&#10; It supports the following dlopen interfaces:&#10;   * dlopen (Solaris, Linux and various BSD flavors)&#10;   * shl_load (HP-UX)&#10;   * LoadLibrary (Win16 and Win32)&#10;   * load_add_on (BeOS)&#10;   * GNU DLD (emulates dynamic linking for static libraries)&#10;   * libtool's dlpreopen" />
                    <attvalue for="3" value="[]" />
                    <attvalue for="4" value="83" />
                    <attvalue for="5" value="no" />
                    <attvalue for="6" value="Ubuntu Developers &lt;ubuntu-devel-discuss@lists.ubuntu.com&gt;" />
                    <attvalue for="7" value="" />
