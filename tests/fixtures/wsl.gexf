                    <attvalue for="2" value="LGPL Crypto library - runtime library&#10; libgcrypt contains cryptographic functions.  Many important free&#10; ciphers, hash algorithms and public key signing algorithms have been&#10; implemented:&#10; .&#10; AES, Arcfour, Blowfish, Camellia, CAST5, ChaCha20 DES, GOST28147,&#10; Salsa20, SEED, Serpent, Twofish, ECB, CFB, CBC, OFB, CTR, CCM, GCM, OCB,&#10; POLY1305, AESWRAP, MD2, MD4, MD5, GOST R 34.11, RIPE-MD160, SHA-1,&#10; SHA2-224, SHA2-256, SHA2-384, SHA2-512, SHA3-224, SHA3-256, SHA3-384,&#10; SHA3-512, SHAKE-128, SHAKE-256, TIGER-192, Whirlpool, HMAC, CMAC,&#10; GMAC-AES, GMAC-CAMELLIA, GMAC-TWOFISH, GMAC-SERPENT, GMAC-SEED,&#10; Poly1305, Poly1305-AES, Poly1305-CAMELLIA, Poly1305-TWOFISH,&#10; Poly1305-SERPENT, Poly1305-SEED, RSA, Elgamal, DSA, ECDSA, EdDSA, ECDH,&#10; ML-DSA, ML-KEM, SNTRUP761, Classic McEliece" />
                    <attvalue for="3" value="[]" />
                    <attvalue for="4" value="1839" />
                    <attvalue for="5" value="no" />
                    <attvalue for="6" value="Ubuntu Developers &lt;ubuntu-devel-discuss@lists.ubuntu.com&gt;" />
                    <attvalue for="7" value="" />
