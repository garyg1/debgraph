            <node id="633" label="python3-venv">
                <attvalues>
                    <attvalue for="0" value="venv module for python3 (default python3 version)" />
                    <attvalue for="1" value="[]" />
                    <attvalue for="2" value="venv module for python3 (default python3 version)&#10; This package contains the venv module for the Python language (default python3&#10; version).&#10; .&#10; The venv module provides support for creating lightweight &quot;virtual&#10; environments&quot; with their own site directories, optionally isolated from system&#10; site directories. Each virtual environment has its own Python binary (which&#10; matches the version of the binary that was used to create this environment)&#10; and can have its own independent set of installed Python packages in its site&#10; directories.&#10; .&#10; This package is a dependency package, which depends on Debian's default&#10; Python 3 version's venv module (currently v3.14)." />
                    <attvalue for="3" value="[]" />
                    <attvalue for="4" value="6" />
                    <attvalue for="5" value="no" />
