            <node id="439" label="libxcomposite1:amd64">
                <attvalues>
                    <attvalue for="0" value="X11 Composite extension library" />
                    <attvalue for="1" value="[]" />
                    <attvalue for="2" value="X11 Composite extension library&#10; libXcomposite provides an X Window System client interface to the Composite&#10; extension to the X protocol.&#10; .&#10; The Composite extension allows clients called compositing managers to control&#10; the final drawing of the screen.  Rendering is done into an off-screen buffer.&#10; .&#10; More information about X.Org can be found at:&#10; &lt;URL:http://www.X.org&gt;&#10; .&#10; This module can be found at&#10; git://anongit.freedesktop.org/git/xorg/lib/libXcomposite" />
                    <attvalue for="3" value="[]" />
                    <attvalue for="4" value="30" />
                    <attvalue for="5" value="no" />
                    <attvalue for="6" value="Ubuntu Developers &lt;ubuntu-devel-discuss@lists.ubuntu.com&gt;" />
                    <attvalue for="7" value="" />
                    <attvalue for="8" value="[]" />
