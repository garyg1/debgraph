                    <attvalue for="8" value='[[{"name": "python3-cffi-backend-api-9729", "op": null, "version": null}], [{"name": "python3-cffi-backend-api-max", "op": "=", "version": "10495"}], [{"name": "python3-cffi-backend-api-min", "op": "=", "version": "9729"}]]' />
