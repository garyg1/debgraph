	"libnss-systemd:amd64" [label="libnss-systemd:amd64" "binary:Synopsis"="nss module providing dynamic user and group name resolution" Breaks="[]" Description="nss module providing dynamic user and group name resolution
 nss-systemd is a plug-in module for the GNU Name Service Switch (NSS)
 functionality of the GNU C Library (glibc), providing UNIX user and group name
 resolution for dynamic users and groups allocated through the DynamicUser=
 option in systemd unit files. See systemd.exec(5) for details on this
 option.
 .
 Installing this package automatically adds the module to /etc/nsswitch.conf." Enhances="[]" InstalledSizeKB=515 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[[{\"name\": \"libblkid1\", \"op\": null, \"version\": null}], [{\"name\": \"libmount1\", \"op\": null, \"version\": null}], [{\"name\": \"libselinux1\", \"op\": null, \"version\": null}]]" Replaces="[]" Section=admin "source:Package"=systemd "source:Version"="259.5-0ubuntu3" Suggests="[[{\"name\": \"libcryptsetup12\", \"op\": null, \"version\": null}], [{\"name\": \"libidn2-0\", \"op\": null, \"version\": null}], [{\"name\": \"libp11-kit0\", \"op\": null, \"version\": null}], [{\"name\": \"libtss2-esys-3.0.2-0t64\", \"op\": null, \"version\": null}], [{\"name\": \"libtss2-mu-4.0.1-0t64\", \"op\": null, \"version\": null}], [{\"name\": \"libtss2-rc0t64\", \"op\": null, \"version\": null}], [{\"name\": \"systemd-userdbd\", \"op\": null, \"version\": null}]]" Version="259.5-0ubuntu3"]
