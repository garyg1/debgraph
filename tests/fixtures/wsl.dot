	"openssh-client" [label="openssh-client" "binary:Synopsis"="secure shell (SSH) client, for secure access to remote machines" Breaks="[[{\"name\": \"openssh-sk-helper\", \"op\": null, \"version\": null}]]" Description="secure shell (SSH) client, for secure access to remote machines
 This is the portable version of OpenSSH, a free implementation of
 the Secure Shell protocol as specified by the IETF secsh working
 group.
 .
 Ssh (Secure Shell) is a program for logging into a remote machine
 and for executing commands on a remote machine.
 It provides secure encrypted communications between two untrusted
 hosts over an insecure network. X11 connections and arbitrary TCP/IP
 ports can also be forwarded over the secure channel.
 It can be used to provide applications with a secure communication
 channel.
 .
 This package provides the ssh, scp and sftp clients, the ssh-agent
 and ssh-add programs to make public key authentication more convenient,
 and the ssh-keygen, ssh-keyscan, ssh-copy-id and ssh-argv0 utilities.
 .
 In some countries it may be illegal to use any encryption at all
 without a special permit.
 .
 ssh replaces the insecure rsh, rcp and rlogin programs, which are
 obsolete for most purposes." Enhances="[]" InstalledSizeKB=3673 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[[{\"name\": \"ssh-client\", \"op\": null, \"version\": null}]]" Recommends="[[{\"name\": \"xauth\", \"op\": null, \"version\": null}]]" Replaces="[[{\"name\": \"openssh-sk-helper\", \"op\": null, \"version\": null}], [{\"name\": \"ssh\", \"op\": null, \"version\": null}], [{\"name\": \"ssh-krb5\", \"op\": null, \"version\": null}]]" Section=net "source:Package"=openssh "source:Version"="1:10.2p1-2ubuntu3.2" Suggests="[[{\"name\": \"keychain\", \"op\": null, \"version\": null}], [{\"name\": \"libpam-ssh\", \"op\": null, \"version\": null}], [{\"name\": \"monkeysphere\", \"op\": null, \"version\": null}], [{\"name\": \"ssh-askpass\", \"op\": null, \"version\": null}]]" Version="1:10.2p1-2ubuntu3.2"]
	openssl [label=openssl "binary:Synopsis"="Secure Sockets Layer toolkit - cryptographic utility" Breaks="[]" Description="Secure Sockets Layer toolkit - cryptographic utility
 This package is part of the OpenSSL project's implementation of the SSL
 and TLS cryptographic protocols for secure communication over the
 Internet.
 .
 It contains the general-purpose command line binary /usr/bin/openssl,
 useful for cryptographic operations such as:
  * creating RSA, DH, and DSA key parameters;
  * creating X.509 certificates, CSRs, and CRLs;
  * calculating message digests;
  * encrypting and decrypting with ciphers;
  * testing SSL/TLS clients and servers;
  * handling S/MIME signed or encrypted mail." Enhances="[]" InstalledSizeKB=2523 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[]" Replaces="[]" Section=utils "source:Package"=openssl "source:Version"="3.5.5-1ubuntu3.2" Suggests="[[{\"name\": \"ca-certificates\", \"op\": null, \"version\": null}]]" Version="3.5.5-1ubuntu3.2"]
	"openssl-provider-legacy" [label="openssl-provider-legacy" "binary:Synopsis"="Secure Sockets Layer toolkit - cryptographic utility" Breaks="[[{\"name\": \"libssl3\", \"op\": \"<<\", \"version\": \"3.3.1-5\"}], [{\"name\": \"libssl3t64\", \"op\": \"<<\", \"version\": \"3.3.1-5\"}]]" Description="Secure Sockets Layer toolkit - cryptographic utility
 This package is part of the OpenSSL project's implementation of the SSL
 and TLS cryptographic protocols for secure communication over the
 Internet.
 .
 This package contains the legacy provider. The OpenSSL legacy provider
 supplies OpenSSL implementations of algorithms that have been deemed legacy.
 Such algorithms have commonly fallen out of use, have been deemed insecure by
 the cryptography community, or something similar.
 For details see OSSL_PROVIDER-legacy man page." Enhances="[]" InstalledSizeKB=422 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[]" Replaces="[[{\"name\": \"libssl3\", \"op\": \"<<\", \"version\": \"3.3.1-5\"}], [{\"name\": \"libssl3t64\", \"op\": \"<<\", \"version\": \"3.3.1-5\"}]]" Section=utils "source:Package"=openssl "source:Version"="3.5.5-1ubuntu3.2" Suggests="[]" Version="3.5.5-1ubuntu3.2"]
	packagekit [label=packagekit "binary:Synopsis"="Provides a package management service" Breaks="[[{\"name\": \"plymouth\", \"op\": \"<<\", \"version\": \"0.9.5\"}]]" Description="Provides a package management service
 PackageKit allows performing simple software management tasks over a DBus
 interface e.g. refreshing the cache, updating, installing and removing
 software packages or searching for multimedia codecs and file handlers.
 .
 The work is done by backends which make use of the package manager shipped by
 the corresponding distribution. PackageKit is not meant to replace
 advanced tools like Synaptic.
 .
 Its main benefits are:
  - Unified developer and user interface on many distributions
  - Fine-grained permission control via PolicyKit
  - On-demand installation of missing system components" Enhances="[]" InstalledSizeKB=1772 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[[{\"name\": \"appstream\", \"op\": null, \"version\": null}]]" Replaces="[]" Section=admin "source:Package"=packagekit "source:Version"="1.3.4-3ubuntu1" Suggests="[]" Version="1.3.4-3ubuntu1"]
	passwd [label=passwd "binary:Synopsis"="change and administer password and group data" Breaks="[]" Description="change and administer password and group data
 This package includes passwd, chsh, chfn, and many other programs to
 maintain password and group data.
 .
 Shadow passwords are supported.  See /usr/share/doc/passwd/README.Debian" Enhances="[]" InstalledSizeKB=4348 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[[{\"name\": \"sensible-utils\", \"op\": null, \"version\": null}]]" Replaces="[[{\"name\": \"login\", \"op\": \"<<\", \"version\": \"1:4.16.0-2~\"}]]" Section=admin "source:Package"=shadow "source:Version"="1:4.17.4-2ubuntu3" Suggests="[]" Version="1:4.17.4-2ubuntu3"]
