	"ubuntu-minimal" [label="ubuntu-minimal" "binary:Synopsis"="Minimal core of Ubuntu" Breaks="[[{\"name\": \"initramfs-tools\", \"op\": \"<<\", \"version\": \"0.142ubuntu9~\"}]]" Description="Minimal core of Ubuntu
 This package depends on all of the packages in the Ubuntu minimal system,
 that is a functional command-line system with the following capabilities:
 .
  - Boot
  - Detect hardware
  - Connect to a network
  - Install packages
  - Perform basic diagnostics
 .
 It is also used to help ensure proper upgrades, so it is recommended that
 it not be removed." Enhances="[]" InstalledSizeKB=14 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[[{\"name\": \"rsyslog\", \"op\": null, \"version\": null}]]" Replaces="[]" Section=metapackages "source:Package"="ubuntu-meta" "source:Version"=1.570 Suggests="[]" Version=1.570]
	"ubuntu-pro-client" [label="ubuntu-pro-client" "binary:Synopsis"="Management tools for Ubuntu Pro" Breaks="[[{\"name\": \"ubuntu-advantage-tools\", \"op\": \"<<\", \"version\": \"31~\"}]]" Description="Management tools for Ubuntu Pro
 Ubuntu Pro is a suite of additional services provided by Canonical on
 top of Ubuntu. Whether you're an enterprise customer deploying systems
 at scale or want security patching for your personal Ubuntu LTS
 at home, the Ubuntu Pro Client (pro) is the command-line tool that
 will help you manage the services you need." Enhances="[]" InstalledSizeKB=1354 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[[{\"name\": \"ubuntu-pro-client-l10n\", \"op\": null, \"version\": null}]]" Replaces="[[{\"name\": \"ubuntu-advantage-tools\", \"op\": \"<<\", \"version\": \"31~\"}]]" Section=misc "source:Package"="ubuntu-advantage-tools" "source:Version"="37.2ubuntu" Suggests="[]" Version="37.2ubuntu"]
