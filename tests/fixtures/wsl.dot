	vim [label=vim "binary:Synopsis"="Vi IMproved - enhanced vi editor" Breaks="[]" Description="Vi IMproved - enhanced vi editor
 Vim is an almost compatible version of the UNIX editor Vi.
 .
 Many new features have been added: multi level undo, syntax
 highlighting, command line history, on-line help, filename
 completion, block operations, folding, Unicode support, etc.
 .
 This package contains a version of vim compiled with a rather
 standard set of features.  This package does not provide a GUI
 version of Vim.  See the other vim-* packages if you need more
 (or less)." Enhances="[]" InstalledSizeKB=4566 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[[{\"name\": \"editor\", \"op\": null, \"version\": null}]]" Recommends="[]" Replaces="[]" Section=editors "source:Package"=vim "source:Version"="2:9.1.2141-1ubuntu4.3" Suggests="[[{\"name\": \"ctags\", \"op\": null, \"version\": null}], [{\"name\": \"vim-doc\", \"op\": null, \"version\": null}], [{\"name\": \"vim-scripts\", \"op\": null, \"version\": null}]]" Version="2:9.1.2141-1ubuntu4.3"]
