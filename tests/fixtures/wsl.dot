	perl [label=perl "binary:Synopsis"="Larry Wall's Practical Extraction and Report Language" Breaks="[[{\"name\": \"apt-show-versions\", \"op\": \"<<\", \"version\": \"0.22.10\"}], [{\"name\": \"libdist-inkt-perl\", \"op\": \"<<\", \"version\": \"0.024-5\"}], [{\"name\": \"libmarc-charset-perl\", \"op\": \"<<\", \"version\": \"1.35-3\"}], [{\"name\": \"libperl-dev\", \"op\": \"<<\", \"version\": \"5.24.0~\"}], [{\"name\": \"perl-doc\", \"op\": \"<<\", \"version\": \"5.40.1-1\"}], [{\"name\": \"perl-modules-5.22\", \"op\": null, \"version\": null}], [{\"name\": \"perl-modules-5.24\", \"op\": null, \"version\": null}], [{\"name\": \"perl-modules-5.26\", \"op\": \"<<\", \"version\": \"5.26.2-5\"}]]" Description="Larry Wall's Practical Extraction and Report Language
 Perl is a highly capable, feature-rich programming language with over
 20 years of development. Perl 5 runs on over 100 platforms from
 portables to mainframes. Perl is suitable for both rapid prototyping
 and large scale development projects.
 .
 Perl 5 supports many programming styles, including procedural,
 functional, and object-oriented. In addition to this, it is supported
 by an ever-growing collection of reusable modules which accelerate
 development. Some of these modules include Web frameworks, database
 integration, networking protocols, and encryption. Perl provides
 interfaces to C and C++ for custom extension development." Enhances="[]" InstalledSizeKB=835 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[[{\"name\": \"libansicolor-perl\", \"op\": \"=\", \"version\": \"5.01\"}], [{\"name\": \"libarchive-tar-perl\", \"op\": \"=\", \"version\": \"3.02.001\"}], [{\"name\": \"libattribute-handlers-perl\", \"op\": \"=\", \"version\": \"1.03\"}], [{\"name\": \"libautodie-perl\", \"op\": \"=\", \"version\": \"2.37\"}], [{\"name\": \"libcompress-raw-bzip2-perl\", \"op\": \"=\", \"version\": \"2.212\"}], [{\"name\": \"libcompress-raw-zlib-perl\", \"op\": \"=\", \"version\": \"2.212\"}], [{\"name\": \"libcompress-zlib-perl\", \"op\": \"=\", \"version\": \"2.212\"}], [{\"name\": \"libcpan-meta-perl\", \"op\": \"=\", \"version\": \"2.150010\"}], [{\"name\": \"libcpan-meta-requirements-perl\", \"op\": \"=\", \"version\": \"2.143\"}], [{\"name\": \"libcpan-meta-yaml-perl\", \"op\": \"=\", \"version\": \"0.018\"}], [{\"name\": \"libdigest-md5-perl\", \"op\": \"=\", \"version\": \"2.58.01\"}], [{\"name\": \"libdigest-perl\", \"op\": \"=\", \"version\": \"1.20\"}], [{\"name\": \"libdigest-sha-perl\", \"op\": \"=\", \"version\": \"6.04\"}], [{\"name\": \"libencode-perl\", \"op\": \"=\", \"version\": \"3.21\"}], [{\"name\": \"libexperimental-perl\", \"op\": \"=\", \"version\": \"0.032\"}], [{\"name\": \"libextutils-cbuilder-perl\", \"op\": \"=\", \"version\": \"0.280240\"}], [{\"name\": \"libextutils-command-perl\", \"op\": \"=\", \"version\": \"7.70\"}], [{\"name\": \"libextutils-install-perl\", \"op\": \"=\", \"version\": \"2.22\"}], [{\"name\": \"libextutils-parsexs-perl\", \"op\": \"=\", \"version\": \"3.510000\"}], [{\"name\": \"libfile-spec-perl\", \"op\": \"=\", \"version\": \"3.9100\"}], [{\"name\": \"libhttp-tiny-perl\", \"op\": \"=\", \"version\": \"0.088\"}], [{\"name\": \"libi18n-langtags-perl\", \"op\": \"=\", \"version\": \"0.45\"}], [{\"name\": \"libio-compress-base-perl\",