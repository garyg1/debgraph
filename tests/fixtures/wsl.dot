 predecessor, bzip (.bz)." Enhances="[]" InstalledSizeKB=99 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[]" Replaces="[]" Section=libs "source:Package"=bzip2 "source:Version"="1.0.8-6build2" Suggests="[]" Version="1.0.8-6build2"]
