	"libvulkan1:amd64" [label="libvulkan1:amd64" "binary:Synopsis"="Vulkan loader library" Breaks="[[{\"name\": \"libvulkan-dev\", \"op\": \"<<\", \"version\": \"1.1.70+dfsg1-2\"}], [{\"name\": \"vulkan-loader\", \"op\": null, \"version\": null}]]" Description="Vulkan loader library
