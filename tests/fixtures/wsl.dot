 ASCII and UTF-8 input." Enhances="[]" InstalledSizeKB=708 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[]" Replaces="[]" Section=libs "source:Package"=pcre2 "source:Version"="10.46-1build1" Suggests="[]" Version="10.46-1build1"]
