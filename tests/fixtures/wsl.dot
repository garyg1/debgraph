digraph Debian {
	adduser [label=adduser "binary:Synopsis"="add and remove users and groups" Breaks="[]" Description="add and remove users and groups
 This package includes the 'adduser' and 'deluser' commands for creating
 and removing users.
 .
  - 'adduser' creates new users and groups and adds existing users to
    existing groups;
  - 'deluser' removes users and groups and removes users from a given
    group.
 .
 Adding users with 'adduser' is much easier than adding them manually.
 'Adduser' will choose UID and GID values that conform to Debian policy,
 create a home directory, copy skeletal user configuration, and
 automate setting initial values for the user's password, real name
 and so on.
 .
 'Deluser' can back up and remove users' home directories
 and mail spool or all the files they own on the system.
 .
 A custom script can be executed after each of the commands.
 .
 'Adduser' and 'Deluser' are intended to be used by the local
 administrator in lieu of the tools from the 'useradd' suite, and
 they provide support for easy use from Debian package maintainer
 scripts, functioning as kind of a policy layer to make those scripts
 easier and more stable to write and maintain." Enhances="[]" InstalledSizeKB=437 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[]" Replaces="[]" Section=admin "source:Package"=adduser "source:Version"="3.153ubuntu1" Suggests="[[{\"name\": \"liblocale-gettext-perl\", \"op\": null, \"version\": null}], [{\"name\": \"perl\", \"op\": null, \"version\": null}], [{\"name\": \"cron\", \"op\": null, \"version\": null}], [{\"name\": \"quota\", \"op\": null, \"version\": null}], [{\"name\": \"ecryptfs-utils\", \"op\": \">=\", \"version\": \"67-1\"}]]" Version="3.153ubuntu1"]
	"adwaita-icon-theme" [label="adwaita-icon-theme" "binary:Synopsis"="default icon theme of GNOME" Breaks="[[{\"name\": \"adwaita-icon-theme-full\", \"op\": \"<<\", \"version\": \"45.1\"}], [{\"name\": \"gnome-themes-standard-data\", \"op\": \"<<\", \"version\": \"3.18.0-2~\"}], [{\"name\": \"libmutter-12-0\", \"op\": \"<<\", \"version\": \"44.8-3~\"}], [{\"name\": \"libmutter-13-0\", \"op\": \"<<\", \"version\": \"45.3-3~\"}]]" Description="default icon theme of GNOME
 This package contains the default icon theme used by the GNOME desktop.
 The icons are used in core apps like Settings, Files, and GNOME Shell.
 .
 Other apps are recommended to include their own icons using the GNOME
 Design Team's Icon Development Kit." Enhances="[]" InstalledSizeKB=13488 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[[{\"name\": \"adwaita-icon-theme-full\", \"op\": \"=\", \"version\": \"50.0-1\"}], [{\"name\": \"gnome-icon-theme-symbolic\", \"op\": null, \"version\": null}]]" Recommends="[[{\"name\": \"librsvg2-common\", \"op\": null, \"version\": null}]]" Replaces="[[{\"name\": \"adwaita-icon-theme-full\", \"op\": \"<<\", \"version\": \"45.1\"}], [{\"name\": \"gnome-themes-standard-data\", \"op\": \"<<\", \"version\": \"3.18.0-2~\"}]]" Section=gnome "source:Package"="adwaita-icon-theme" "source:Version"="50.0-1" Suggests="[[{\"name\": \"adwaita-icon-theme-legacy\", \"op\": null, \"version\": null}]]" Version="50.0-1"]
	"alsa-topology-conf" [label="alsa-topology-conf" "binary:Synopsis"="ALSA topology configuration files" Breaks="[[{\"name\": \"libasound2-data\", \"op\": \"<<\", \"version\": \"1.2.1\"}]]" Description="ALSA topology configuration files
 This package contains ALSA topology configuration files that can be used
 by libasound2 for specific audio hardware.
 .
 ALSA is the Advanced Linux Sound Architecture." Enhances="[[{\"name\": \"libasound2-data\", \"op\": null, \"version\": null}]]" InstalledSizeKB=420 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[]" Replaces="[[{\"name\": \"libasound2-data\", \"op\": \"<<\", \"version\": \"1.2.1\"}]]" Section=libs "source:Package"="alsa-topology-conf" "source:Version"="1.2.5.1-3build1" Suggests="[]" Version="1.2.5.1-3build1"]
	"alsa-ucm-conf" [label="alsa-ucm-conf" "binary:Synopsis"="ALSA Use Case Manager configuration files" Breaks="[]" Description="ALSA Use Case Manager configuration files
 This package contains ALSA Use Case Manager configuration of audio
 input/output names and routing for specific audio hardware. They can be
 used with the alsaucm tool.
 .
 Installing these configuration files is absolutely necessary to make some
 sound hardware work. Its installation is highly recommended in order to
 use ALSA-backed hardware.
 .
 ALSA is the Advanced Linux Sound Architecture." Enhances="[]" InstalledSizeKB=1515 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[]" Replaces="[]" Section=libs "source:Package"="alsa-ucm-conf" "source:Version"="1.2.15.3-1ubuntu1" Suggests="[]" Version="1.2.15.3-1ubuntu1"]
	apparmor [label=apparmor "binary:Synopsis"="user-space parser utility for AppArmor" Breaks="[[{\"name\": \"apparmor-profiles-extra\", \"op\": \"<<\", \"version\": \"1.21\"}], [{\"name\": \"fcitx-data\", \"op\": \"<<\", \"version\": \"1:4.2.9.1-1ubuntu2\"}], [{\"name\": \"snapd\", \"op\": \"<<\", \"version\": \"2.44.3+20.04~\"}]]" Description="user-space parser utility for AppArmor
 apparmor provides the system initialization scripts needed to use the
 AppArmor Mandatory Access Control system, including the AppArmor Parser
 which is required to convert AppArmor text profiles into machine-readable
 policies that are loaded into the kernel for use with the AppArmor Linux
 Security Module." Enhances="[]" InstalledSizeKB=2416 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[]" Replaces="[[{\"name\": \"fcitx-data\", \"op\": \"<<\", \"version\": \"1:4.2.9.1-1ubuntu2\"}]]" Section=admin "source:Package"=apparmor "source:Version"="5.0.0~beta1-0ubuntu7" Suggests="[[{\"name\": \"apparmor-profiles-extra\", \"op\": null, \"version\": null}], [{\"name\": \"apparmor-utils\", \"op\": null, \"version\": null}]]" Version="5.0.0~beta1-0ubuntu7"]
	apport [label=apport "binary:Synopsis"="automatically generate crash reports for debugging" Breaks="[[{\"name\": \"python-apport\", \"op\": \"<<\", \"version\": \"2.2-0ubuntu1\"}]]" Description="automatically generate crash reports for debugging
 apport automatically collects data from crashed processes and
 compiles a problem report in /var/crash/. This utilizes the crashdump
 helper hook provided by the Ubuntu kernel.
 .
 This package also provides a command line frontend for browsing and
 handling the crash reports. For desktops, you should consider
 installing the GTK+ or Qt user interface (apport-gtk or apport-kde)." Enhances="[]" InstalledSizeKB=640 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[[{\"name\": \"apport-symptoms\", \"op\": null, \"version\": null}], [{\"name\": \"python3-systemd\", \"op\": null, \"version\": null}]]" Replaces="[[{\"name\": \"python-apport\", \"op\": \"<<\", \"version\": \"2.2-0ubuntu1\"}]]" Section=utils "source:Package"=apport "source:Version"="2.34.0-0ubuntu2" Suggests="[[{\"name\": \"apport-gtk\", \"op\": null, \"version\": null}, {\"name\": \"apport-kde\", \"op\": null, \"version\": null}], [{\"name\": \"pkexec\", \"op\": null, \"version\": null}], [{\"name\": \"polkitd\", \"op\": null, \"version\": null}]]" Version="2.34.0-0ubuntu2"]
	"apport-core-dump-handler" [label="apport-core-dump-handler" "binary:Synopsis"="Kernel core dump handler for Apport" Breaks="[[{\"name\": \"apport\", \"op\": \"<<\", \"version\": \"2.27.0-0ubuntu7~\"}]]" Description="Kernel core dump handler for Apport
 apport automatically collects data from crashed processes and
 compiles a problem report in /var/crash/. This utilizes the crashdump
 helper hook provided by the Ubuntu kernel.
 .
 This package provides the service that configures the kernel (via
 /proc/sys/kernel/core_pattern) to forward the crash dumps to apport." Enhances="[]" InstalledSizeKB=28 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[[{\"name\": \"core-dump-handler\", \"op\": null, \"version\": null}]]" Recommends="[]" Replaces="[[{\"name\": \"apport\", \"op\": \"<<\", \"version\": \"2.27.0-0ubuntu7~\"}], [{\"name\": \"core-dump-handler\", \"op\": null, \"version\": null}]]" Section=utils "source:Package"=apport "source:Version"="2.34.0-0ubuntu2" Suggests="[]" Version="2.34.0-0ubuntu2"]
	"apport-symptoms" [label="apport-symptoms" "binary:Synopsis"="symptom scripts for apport" Breaks="[]" Description="symptom scripts for apport
 Apport intercepts program crashes, collects debugging information about the
 crash and the operating system environment, and sends it to bug trackers in a
 standardized form. It also offers the user to report a bug about a package,
 with again collecting as much information about it as possible.
 .
 This package extends Apport by some \"symptom\" scripts, so that bug reporters
 do not have to guess the correct package, but report problems based on
 symptoms that they have (like \"sound problem\"), through an interactive process." Enhances="[]" InstalledSizeKB=60 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-motu@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[[{\"name\": \"apport\", \"op\": null, \"version\": null}]]" Replaces="[]" Section=utils "source:Package"="apport-symptoms" "source:Version"="0.25build1" Suggests="[]" Version="0.25build1"]
	appstream [label=appstream "binary:Synopsis"="Software component metadata management" Breaks="[]" Description="Software component metadata management
 AppStream is a metadata specification which permits software components to
 provide information about themselves to automated systems and end-users
 before the software is actually installed.
 The AppStream project provides facilities to easily access and transform
 this metadata, as well as a few additional services to allow building
 feature-rich software centers and similar applications.
 .
 This package provides tools to generate, maintain and query the AppStream
 data pool of installed and available software, and enables integration
 with the APT package manager.
 .
 The 'appstreamcli' tool can be used for accessing the software component
 pool as well as for working with AppStream metadata directly, including
 validating it for compliance with the specification." Enhances="[]" InstalledSizeKB=352 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[]" Replaces="[]" Section=admin "source:Package"=appstream "source:Version"="1.1.2-1" Suggests="[[{\"name\": \"apt-config-icons\", \"op\": null, \"version\": null}]]" Version="1.1.2-1"]
	apt [label=apt "binary:Synopsis"="commandline package manager" Breaks="[[{\"name\": \"apt-transport-https\", \"op\": \"<<\", \"version\": \"1.5~alpha4~\"}], [{\"name\": \"apt-utils\", \"op\": \"<<\", \"version\": \"1.3~exp2~\"}], [{\"name\": \"aptitude\", \"op\": \"<<\", \"version\": \"0.8.10\"}]]" Description="commandline package manager
 This package provides commandline tools for searching and
 managing as well as querying information about packages
 as a low-level access to all features of the libapt-pkg library.
 .
 These include:
  * apt-get for retrieval of packages and information about them
    from authenticated sources and for installation, upgrade and
    removal of packages together with their dependencies
  * apt-cache for querying available information about installed
    as well as installable packages
  * apt-cdrom to use removable media as a source for packages
  * apt-config as an interface to the configuration settings
  * apt-extracttemplates is used by debconf to prompt for configuration
    questions before installation." Enhances="[]" InstalledSizeKB=4398 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[[{\"name\": \"apt-transport-https\", \"op\": \"=\", \"version\": \"3.2.0\"}]]" Recommends="[[{\"name\": \"ca-certificates\", \"op\": null, \"version\": null}]]" Replaces="[[{\"name\": \"apt-transport-https\", \"op\": \"<<\", \"version\": \"1.5~alpha4~\"}], [{\"name\": \"apt-utils\", \"op\": \"<<\", \"version\": \"1.3~exp2~\"}]]" Section=admin "source:Package"=apt "source:Version"="3.2.0" Suggests="[[{\"name\": \"apt-doc\", \"op\": null, \"version\": null}], [{\"name\": \"aptitude\", \"op\": null, \"version\": null}, {\"name\": \"synaptic\", \"op\": null, \"version\": null}, {\"name\": \"wajig\", \"op\": null, \"version\": null}], [{\"name\": \"dpkg-dev\", \"op\": \">=\", \"version\": \"1.17.2\"}], [{\"name\": \"gnupg\", \"op\": null, \"version\": null}, {\"name\": \"gnupg2\", \"op\": null, \"version\": null}, {\"name\": \"gnupg1\", \"op\": null, \"version\": null}], [{\"name\": \"powermgmt-base\", \"op\": null, \"version\": null}]]" Version="3.2.0"]
	"at-spi2-common" [label="at-spi2-common" "binary:Synopsis"="Assistive Technology Service Provider Interface (common files)" Breaks="[[{\"name\": \"at-spi2-core\", \"op\": \"<<\", \"version\": \"2.46.0-2~\"}]]" Description="Assistive Technology Service Provider Interface (common files)
 This package contains the common resource files of GNOME Accessibility." Enhances="[]" InstalledSizeKB=52 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[]" Replaces="[[{\"name\": \"at-spi2-core\", \"op\": \"<<\", \"version\": \"2.46.0-2~\"}]]" Section=misc "source:Package"="at-spi2-core" "source:Version"="2.60.0-1" Suggests="[]" Version="2.60.0-1"]
	"at-spi2-core" [label="at-spi2-core" "binary:Synopsis"="Assistive Technology Service Provider Interface (D-Bus core)" Breaks="[]" Description="Assistive Technology Service Provider Interface (D-Bus core)
 This package contains the core components of GNOME Accessibility." Enhances="[]" InstalledSizeKB=178 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[]" Replaces="[]" Section=misc "source:Package"="at-spi2-core" "source:Version"="2.60.0-1" Suggests="[]" Version="2.60.0-1"]
	"base-files" [label="base-files" "binary:Synopsis"="Debian base system miscellaneous files" Breaks="[[{\"name\": \"debian-security-support\", \"op\": \"<<\", \"version\": \"2019.04.25\"}], [{\"name\": \"initscripts\", \"op\": \"<<\", \"version\": \"2.88dsf-13.3\"}], [{\"name\": \"sendfile\", \"op\": \"<<\", \"version\": \"2.1b.20080616-5.2~\"}], [{\"name\": \"ubuntu-server\", \"op\": \"<<\", \"version\": \"1.453\"}]]" Description="Debian base system miscellaneous files
 This package contains the basic filesystem hierarchy of a Debian system, and
 several important miscellaneous files, such as /etc/debian_version,
 /etc/host.conf, /etc/issue, /etc/motd, /etc/profile, and others,
 and the text of several common licenses in use on Debian systems." Enhances="[]" InstalledSizeKB=440 IsEssential=yes Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[[{\"name\": \"base\", \"op\": null, \"version\": null}], [{\"name\": \"usr-is-merged\", \"op\": null, \"version\": null}]]" Recommends="[]" Replaces="[[{\"name\": \"base\", \"op\": null, \"version\": null}], [{\"name\": \"dpkg\", \"op\": \"<=\", \"version\": \"1.15.0\"}], [{\"name\": \"miscutils\", \"op\": null, \"version\": null}]]" Section=admin "source:Package"="base-files" "source:Version"="14ubuntu6" Suggests="[]" Version="14ubuntu6"]
	"base-passwd" [label="base-passwd" "binary:Synopsis"="Debian base system master password and group files" Breaks="[]" Description="Debian base system master password and group files
 These are the canonical master copies of the user database files
 (/etc/passwd and /etc/group), containing the Debian-allocated user and
 group IDs. The update-passwd tool is provided to keep the system databases
 synchronized with these master files." Enhances="[]" InstalledSizeKB=277 IsEssential=yes Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[[{\"name\": \"debconf\", \"op\": \">=\", \"version\": \"0.5\"}, {\"name\": \"debconf-2.0\", \"op\": null, \"version\": null}]]" Replaces="[[{\"name\": \"base\", \"op\": null, \"version\": null}]]" Section=admin "source:Package"="base-passwd" "source:Version"="3.6.8" Suggests="[]" Version="3.6.8"]
	bash [label=bash "binary:Synopsis"="GNU Bourne Again SHell" Breaks="[]" Description="GNU Bourne Again SHell
 Bash is an sh-compatible command language interpreter that executes
 commands read from the standard input or from a file.  Bash also
 incorporates useful features from the Korn and C shells (ksh and csh).
 .
 Bash is ultimately intended to be a conformant implementation of the
 IEEE POSIX Shell and Tools specification (IEEE Working Group 1003.2).
 .
 The Programmable Completion Code, by Ian Macdonald, is now found in
 the bash-completion package." Enhances="[]" InstalledSizeKB=2020 IsEssential=yes Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[[{\"name\": \"bash-completion\", \"op\": null, \"version\": null}]]" Replaces="[]" Section=shells "source:Package"=bash "source:Version"="5.3-2ubuntu1" Suggests="[[{\"name\": \"bash-doc\", \"op\": null, \"version\": null}]]" Version="5.3-2ubuntu1"]
	"bash-completion" [label="bash-completion" "binary:Synopsis"="programmable completion for the bash shell" Breaks="[]" Description="programmable completion for the bash shell
 bash completion extends bash's standard completion behavior to achieve
 complex command lines with just a few keystrokes.  This project was
 conceived to produce programmable completion routines for the most
 common Linux/UNIX commands, reducing the amount of typing sysadmins
 and programmers need to do on a daily basis." Enhances="[]" InstalledSizeKB=1952 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[[{\"name\": \"dh-sequence-bash-completion\", \"op\": null, \"version\": null}]]" Recommends="[]" Replaces="[]" Section=shells "source:Package"="bash-completion" "source:Version"="1:2.16.0-8build1" Suggests="[]" Version="1:2.16.0-8build1"]
	bc [label=bc "binary:Synopsis"="GNU bc arbitrary precision calculator language" Breaks="[]" Description="GNU bc arbitrary precision calculator language
 GNU bc is an interactive algebraic language with arbitrary precision which
 follows the POSIX 1003.2 draft standard, with several extensions including
 multi-character variable names, an `else' statement and full Boolean
 expressions.  GNU bc does not require the separate GNU dc program." Enhances="[]" InstalledSizeKB=211 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[]" Replaces="[]" Section=math "source:Package"=bc "source:Version"="1.07.1-4build1" Suggests="[]" Version="1.07.1-4build1"]
	binutils [label=binutils "binary:Synopsis"="GNU assembler, linker and binary utilities" Breaks="[[{\"name\": \"binutils-aarch64-linux-gnu\", \"op\": \"<<\", \"version\": \"2.43.90\"}], [{\"name\": \"binutils-i686-linux-gnu\", \"op\": \"<<\", \"version\": \"2.43.90\"}], [{\"name\": \"binutils-riscv64-linux-gnu\", \"op\": \"<<\", \"version\": \"2.43.90\"}], [{\"name\": \"binutils-x86-64-linux-gnu\", \"op\": \"<<\", \"version\": \"2.43.90\"}], [{\"name\": \"libc6-dev\", \"op\": \"<<\", \"version\": \"2.42-2ubuntu4\"}]]" Description="GNU assembler, linker and binary utilities
 The programs in this package are used to assemble, link and manipulate
 binary and object files.  They may be used in conjunction with a compiler
 and various libraries to build programs." Enhances="[]" InstalledSizeKB=1150 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[[{\"name\": \"elf-binutils\", \"op\": null, \"version\": null}]]" Recommends="[]" Replaces="[[{\"name\": \"binutils-aarch64-linux-gnu\", \"op\": \"<<\", \"version\": \"2.43.90\"}], [{\"name\": \"binutils-common\", \"op\": \"<<\", \"version\": \"2.43.90\"}], [{\"name\": \"binutils-i686-linux-gnu\", \"op\": \"<<\", \"version\": \"2.43.90\"}], [{\"name\": \"binutils-riscv64-linux-gnu\", \"op\": \"<<\", \"version\": \"2.43.90\"}], [{\"name\": \"binutils-x86-64-linux-gnu\", \"op\": \"<<\", \"version\": \"2.43.90\"}]]" Section=devel "source:Package"=binutils "source:Version"="2.46-3ubuntu2" Suggests="[[{\"name\": \"binutils-doc\", \"op\": \">=\", \"version\": \"2.46-3ubuntu2\"}], [{\"name\": \"gprofng-gui\", \"op\": null, \"version\": null}], [{\"name\": \"binutils-gold\", \"op\": null, \"version\": null}]]" Version="2.46-3ubuntu2"]
	"binutils-common:amd64" [label="binutils-common:amd64" "binary:Synopsis"="Common files for the GNU assembler, linker and binary utilities" Breaks="[[{\"name\": \"binutils\", \"op\": \"<<\", \"version\": \"2.38.50.20220527-2\"}], [{\"name\": \"binutils-multiarch\", \"op\": \"<<\", \"version\": \"2.38.50.20220527-2\"}]]" Description="Common files for the GNU assembler, linker and binary utilities
 This package contains the localization files used by binutils packages for
 various target architectures and parts of the binutils documentation. It is
 not useful on its own." Enhances="[]" InstalledSizeKB=532 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[]" Replaces="[[{\"name\": \"binutils\", \"op\": \"<<\", \"version\": \"2.38.50.20220527-2\"}], [{\"name\": \"binutils-multiarch\", \"op\": \"<<\", \"version\": \"2.38.50.20220527-2\"}]]" Section=devel "source:Package"=binutils "source:Version"="2.46-3ubuntu2" Suggests="[]" Version="2.46-3ubuntu2"]
	"binutils-x86-64-linux-gnu" [label="binutils-x86-64-linux-gnu" "binary:Synopsis"="GNU binary utilities, for x86-64-linux-gnu target" Breaks="[[{\"name\": \"binutils\", \"op\": \"<<\", \"version\": \"2.29-6\"}], [{\"name\": \"binutils-dev\", \"op\": \"<<\", \"version\": \"2.38.50.20220609-2\"}]]" Description="GNU binary utilities, for x86-64-linux-gnu target
 This package provides GNU assembler, linker and binary utilities
 for the x86-64-linux-gnu target.
 .
 You don't need this package unless you plan to cross-compile programs
 for x86-64-linux-gnu and x86-64-linux-gnu is not your native
 platform." Enhances="[]" InstalledSizeKB=6109 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[]" Replaces="[[{\"name\": \"binutils\", \"op\": \"<<\", \"version\": \"2.29-6\"}], [{\"name\": \"binutils-dev\", \"op\": \"<<\", \"version\": \"2.38.50.20220609-2\"}]]" Section=devel "source:Package"=binutils "source:Version"="2.46-3ubuntu2" Suggests="[[{\"name\": \"binutils-doc\", \"op\": \"=\", \"version\": \"2.46-3ubuntu2\"}]]" Version="2.46-3ubuntu2"]
	bsdextrautils [label=bsdextrautils "binary:Synopsis"="extra utilities from 4.4BSD-Lite" Breaks="[[{\"name\": \"bsdmainutils\", \"op\": \"<<\", \"version\": \"12.1.3\"}], [{\"name\": \"util-linux\", \"op\": \"<<\", \"version\": \"2.41.2-2~\"}]]" Description="extra utilities from 4.4BSD-Lite
 This package contains some extra BSD utilities: col, colcrt, colrm, column,
 hd, hexdump, look, rev, ul.
 Other BSD utilities are provided by bsdutils and calendar." Enhances="[]" InstalledSizeKB=284 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[]" Replaces="[[{\"name\": \"bsdmainutils\", \"op\": \"<<\", \"version\": \"12.1.3\"}], [{\"name\": \"util-linux\", \"op\": \"<<\", \"version\": \"2.41.2-2~\"}]]" Section=utils "source:Package"="util-linux" "source:Version"="2.41.3-3ubuntu2" Suggests="[]" Version="2.41.3-3ubuntu2"]
	bsdutils [label=bsdutils "binary:Synopsis"="basic utilities from 4.4BSD-Lite" Breaks="[]" Description="basic utilities from 4.4BSD-Lite
 This package contains the bare minimum of BSD utilities needed for a Debian
 system: renice, script, scriptlive, scriptreplay and wall. The
 remaining standard BSD utilities are provided by bsdextrautils." Enhances="[]" InstalledSizeKB=250 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[[{\"name\": \"bsdextrautils\", \"op\": null, \"version\": null}]]" Replaces="[]" Section=utils "source:Package"="util-linux" "source:Version"="2.41.3-3ubuntu2" Suggests="[]" Version="1:2.41.3-3ubuntu2"]
	bubblewrap [label=bubblewrap "binary:Synopsis"="utility for unprivileged chroot and namespace manipulation" Breaks="[]" Description="utility for unprivileged chroot and namespace manipulation
 bubblewrap uses Linux namespaces to launch unprivileged containers.
 These containers can be used to sandbox semi-trusted applications such
 as Flatpak apps, image/video thumbnailers and web browser components,
 or to run programs in a different library stack such as a Flatpak runtime
 or a different Debian release.
 .
 By default, this package relies on a kernel with user namespaces enabled.
 Official Debian and Ubuntu kernels are suitable.
 .
 On kernels without user namespaces, system administrators can make the
 bwrap executable setuid root, allowing it to create unprivileged
 containers even though ordinary user processes cannot." Enhances="[]" InstalledSizeKB=133 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[]" Replaces="[]" Section=admin "source:Package"=bubblewrap "source:Version"="0.11.1-1ubuntu0.1" Suggests="[]" Version="0.11.1-1ubuntu0.1"]
	"build-essential" [label="build-essential" "binary:Synopsis"="Informational list of build-essential packages" Breaks="[]" Description="Informational list of build-essential packages
 If you do not plan to build Debian packages, you don't need this
 package.  Starting with dpkg (>= 1.14.18) this package is required
 for building Debian packages.
 .
 This package contains an informational list of packages which are
 considered essential for building Debian packages.  This package also
 depends on the packages on that list, to make it easy to have the
 build-essential packages installed.
 .
 If you have this package installed, you only need to install whatever
 a package specifies as its build-time dependencies to build the
 package.  Conversely, if you are determining what your package needs
 to build-depend on, you can always leave out the packages this
 package depends on.
 .
 This package is NOT the definition of what packages are
 build-essential; the real definition is in the Debian Policy Manual.
 This package contains merely an informational list, which is all
 most people need.   However, if this package and the manual disagree,
 the manual is correct." Enhances="[]" InstalledSizeKB=18 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[]" Replaces="[]" Section=devel "source:Package"="build-essential" "source:Version"="12.12ubuntu2" Suggests="[]" Version="12.12ubuntu2"]
	byobu [label=byobu "binary:Synopsis"="text window manager, shell multiplexer, integrated DevOps environment" Breaks="[[{\"name\": \"bikeshed\", \"op\": \"<<\", \"version\": \"1.64\"}], [{\"name\": \"byobu-extras\", \"op\": \"<<\", \"version\": \"2.17\"}], [{\"name\": \"screen-profiles\", \"op\": \"<<\", \"version\": \"2.0\"}], [{\"name\": \"screen-profiles-extras\", \"op\": \"<<\", \"version\": \"2.0\"}]]" Description="text window manager, shell multiplexer, integrated DevOps environment
 Byobu is Ubuntu's powerful text-based window manager, shell multiplexer, and
 integrated DevOps environment.
 .
 Using Byobu, you can quickly create and move between different windows
 over a single SSH connection or TTY terminal, split each of those windows into
 multiple panes, monitor dozens of important statistics about your system,
 detach and reattach to sessions later while your programs continue to run in
 the background." Enhances="[[{\"name\": \"screen\", \"op\": null, \"version\": null}]]" InstalledSizeKB=560 IsEssential=no Maintainer="Dustin Kirkland <kirkland@ubuntu.com>" Origin="" Provides="[[{\"name\": \"byobu-extras\", \"op\": null, \"version\": null}], [{\"name\": \"screen-profiles\", \"op\": null, \"version\": null}], [{\"name\": \"screen-profiles-extras\", \"op\": null, \"version\": null}]]" Recommends="[[{\"name\": \"less\", \"op\": null, \"version\": null}], [{\"name\": \"pastebinit\", \"op\": null, \"version\": null}], [{\"name\": \"sensible-utils\", \"op\": null, \"version\": null}], [{\"name\": \"run-one\", \"op\": null, \"version\": null}]]" Replaces="[[{\"name\": \"bikeshed\", \"op\": \"<<\", \"version\": \"1.64\"}], [{\"name\": \"byobu-extras\", \"op\": \"<<\", \"version\": \"2.17\"}], [{\"name\": \"screen-profiles\", \"op\": \"<<\", \"version\": \"2.0\"}], [{\"name\": \"screen-profiles-extras\", \"op\": \"<<\", \"version\": \"2.0\"}]]" Section=misc "source:Package"=byobu "source:Version"="6.11-0ubuntu3" Suggests="[[{\"name\": \"apport\", \"op\": null, \"version\": null}], [{\"name\": \"ccze\", \"op\": null, \"version\": null}], [{\"name\": \"gnome-terminal\", \"op\": null, \"version\": null}, {\"name\": \"xterm\", \"op\": null, \"version\": null}], [{\"name\": \"gnupg\", \"op\": null, \"version\": null}], [{\"name\": \"lsb-release\", \"op\": null, \"version\": null}], [{\"name\": \"po-debconf\", \"op\": null, \"version\": null}], [{\"name\": \"screen\", \"op\": null, \"version\": null}], [{\"name\": \"speedometer\", \"op\": null, \"version\": null}], [{\"name\": \"ttf-ubuntu-font-family\", \"op\": \">=\", \"version\": \"0.80-0ubuntu1~medium\"}], [{\"name\": \"update-notifier-common\", \"op\": null, \"version\": null}], [{\"name\": \"vim\", \"op\": null, \"version\": null}], [{\"name\": \"wireless-tools\", \"op\": null, \"version\": null}]]" Version="6.11-0ubuntu3"]
	bzip2 [label=bzip2 "binary:Synopsis"="high-quality block-sorting file compressor - utilities" Breaks="[]" Description="high-quality block-sorting file compressor - utilities
 bzip2 is a freely available, patent free, data compressor.
 .
 bzip2 compresses files using the Burrows-Wheeler block-sorting text
 compression algorithm, and Huffman coding.  Compression is generally
 considerably better than that achieved by more conventional
 LZ77/LZ78-based compressors, and approaches the performance of the PPM
 family of statistical compressors.
 .
 The archive file format of bzip2 (.bz2) is incompatible with that of its
 predecessor, bzip (.bz)." Enhances="[]" InstalledSizeKB=111 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[]" Recommends="[]" Replaces="[[{\"name\": \"libbz2\", \"op\": \"<<\", \"version\": \"0.9.5d-3\"}]]" Section=utils "source:Package"=bzip2 "source:Version"="1.0.8-6build2" Suggests="[[{\"name\": \"bzip2-doc\", \"op\": null, \"version\": null}]]" Version="1.0.8-6build2"]
