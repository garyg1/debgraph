	"libnpth0t64:amd64" [label="libnpth0t64:amd64" "binary:Synopsis"="replacement for GNU Pth using system threads" Breaks="[[{\"name\": \"libnpth0\", \"op\": \"<<\", \"version\": \"1.8-3build1\"}]]" Description="replacement for GNU Pth using system threads
 nPth is a non-preemptive threads implementation using an API very
 similar to the one known from GNU Pth. It has been designed as a
 replacement of GNU Pth for non-ancient operating systems. In
 contrast to GNU Pth it is based on the system's standard threads
 implementation. Thus nPth allows the use of libraries which are not
 compatible to GNU Pth." Enhances="[]" InstalledSizeKB=43 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[[{\"name\": \"libnpth0\", \"op\": \"=\", \"version\": \"1.8-3build1\"}]]" Recommends="[]" Replaces="[[{\"name\": \"libnpth0\", \"op\": null, \"version\": null}]]" Section=libs "source:Package"=npth "source:Version"="1.8-3build1" Suggests="[]" Version="1.8-3build1"]
	"libnspr4:amd64" [label="libnspr4:amd64" "binary:Synopsis"="NetScape Portable Runtime Library" Breaks="[]" Description="NetScape Portable Runtime Library
