	git [label=git "binary:Synopsis"="fast, scalable, distributed revision control system" Breaks="[[{\"name\": \"bash-completion\", \"op\": \"<<\", \"version\": \"1:1.90-1\"}], [{\"name\": \"cogito\", \"op\": \"<=\", \"version\": \"0.18.2+\"}], [{\"name\": \"dgit\", \"op\": \"<<\", \"version\": \"5.1~\"}], [{\"name\": \"git-buildpackage\", \"op\": \"<<\", \"version\": \"0.6.5\"}], [{\"name\": \"git-el\", \"op\": \"<<\", \"version\": \"1:2.32.0~rc2-1~\"}], [{\"name\": \"gitosis\", \"op\": \"<<\", \"version\": \"0.2+20090917-7\"}], [{\"name\": \"gitpkg\", \"op\": \"<<\", \"version\": \"0.15\"}], [{\"name\": \"guilt\", \"op\": \"<<\", \"version\": \"0.33\"}], [{\"name\": \"openssh-client\", \"op\": \"<<\", \"version\": \"1:6.8\"}], [{\"name\": \"stgit\", \"op\": \"<<\", \"version\": \"0.15\"}], [{\"name\": \"stgit-contrib\", \"op\": \"<<\", \"version\": \"0.15\"}]]" Description="fast, scalable, distributed revision control system
 Git is popular version control system designed to handle very large
 projects with speed and efficiency; it is used for many high profile
 open source projects, most notably the Linux kernel.
 .
 Git falls in the category of distributed source code management tools.
 Every Git working directory is a full-fledged repository with full
 revision tracking capabilities, not dependent on network access or a
 central server.
 .
 This package provides the git main components with minimal dependencies.
 Additional functionality, e.g. a graphical user interface and revision
 tree visualizer, tools for interoperating with other VCS's, or a web
 interface, is provided as separate git* packages." Enhances="[]" InstalledSizeKB=25264 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[[{\"name\": \"git-completion\", \"op\": null, \"version\": null}], [{\"name\": \"git-core\", \"op\": null, \"version\": null}]]" Recommends="[[{\"name\": \"ca-certificates\", \"op\": null, \"version\": null}], [{\"name\": \"patch\", \"op\": null, \"version\": null}], [{\"name\": \"less\", \"op\": null, \"version\": null}], [{\"name\": \"ssh-client\", \"op\": null, \"version\": null}]]" Replaces="[]" Section=vcs "source:Package"=git "source:Version"="1:2.53.0-1ubuntu1" Suggests="[[{\"name\": \"gettext-base\", \"op\": null, \"version\": null}], [{\"name\": \"git-doc\", \"op\": null, \"version\": null}], [{\"name\": \"git-email\", \"op\": null, \"version\": null}], [{\"name\": \"git-gui\", \"op\": null, \"version\": null}], [{\"name\": \"gitk\", \"op\": null, \"version\": null}], [{\"name\": \"gitweb\", \"op\": null, \"version\": null}], [{\"name\": \"git-cvs\", \"op\": null, \"version\": null}], [{\"name\": \"git-svn\", \"op\": null, \"version\": null}]]" Version="1:2.53.0-1ubuntu1"]
