	findutils [label=findutils "binary:Synopsis"="utilities for finding files--find, xargs" Breaks="[[{\"name\": \"binstats\", \"op\": \"<<\", \"version\": \"1.08-8.1\"}], [{\"name\": \"guilt\", \"op\": \"<<\", \"version\": \"0.36-0.2\"}], [{\"name\": \"libpython3.4-minimal\", \"op\": \"<<\", \"version\": \"3.4.4-2\"}], [{\"name\": \"libpython3.5-minimal\", \"op\": \"<<\", \"version\": \"3.5.1-3\"}], [{\"name\": \"lsat\", \"op\": \"<<\", \"version\": \"0.9.7.1-2.1\"}], [{\"name\": \"mc\", \"op\": \"<<\", \"version\": \"3:4.8.11-1\"}], [{\"name\": \"switchconf\", \"op\": \"<<\", \"version\": \"0.0.9-2.1\"}]]" Description="utilities for finding files--find, xargs
