	snapd [label=snapd "binary:Synopsis"="Daemon and tooling that enable snap packages" Breaks="[[{\"name\": \"snap-confine\", \"op\": \"<<\", \"version\": \"2.23\"}], [{\"name\": \"snapd-xdg-open\", \"op\": \"<=\", \"version\": \"0.0.0\"}], [{\"name\": \"ubuntu-core-launcher\", \"op\": \"<<\", \"version\": \"2.22\"}], [{\"name\": \"ubuntu-snappy\", \"op\": \"<<\", \"version\": \"1.9\"}], [{\"name\": \"ubuntu-snappy-cli\", \"op\": \"<<\", \"version\": \"1.9\"}]]" Description="Daemon and tooling that enable snap packages
