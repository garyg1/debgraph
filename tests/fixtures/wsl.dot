 Architecture independent Perl modules.  These modules are part of Perl and
 required if the `perl' package is installed.
 .
 Note that this package only exists to save archive space and should be
 considered an internal implementation detail of the `perl' package.
 Other packages should not depend on `perl-modules-5.40' directly, they
 should use `perl' (which depends on `perl-modules-5.40') instead." Enhances="[]" InstalledSizeKB=19982 IsEssential=no Maintainer="Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>" Origin="" Provides="[[{\"name\": \"perl-modules\", \"op\": null, \"version\": null}]]" Recommends="[[{\"name\": \"perl\", \"op\": \">=\", \"version\": \"5.40.1-1\"}]]" Replaces="[[{\"name\": \"libansicolor-perl\", \"op\": \"<<\", \"version\": \"5.01\"}], [{\"name\": \"libarchive-tar-perl\", \"op\": \"<<\", \"version\": \"3.02.001\"}], [{\"name\": \"libattribute-handlers-perl\", \"op\": \"<<\", \"version\": \"1.03\"}], [{\"name\": \"libautodie-perl\", \"op\": \"<<\", \"version\": \"2.37\"}], [{\"name\": \"libcpan-meta-perl\", \"op\": \"<<\", \"version\": \"2.150010\"}], [{\"name\": \"libcpan-meta-requirements-perl\", \"op\": \"<<\", \"version\": \"2.143\"}], [{\"name\": \"libcpan-meta-yaml-perl\", \"op\": \"<<\", \"version\": \"0.018\"}], [{\"name\": \"libdigest-perl\", \"op\": \"<<\", \"version\": \"1.20\"}], [{\"name\": \"libexperimental-perl\", \"op\": \"<<\", \"version\": \"0.032\"}], [{\"name\": \"libextutils-cbuilder-perl\", \"op\": \"<<\", \"version\": \"0.280240\"}], [{\"name\": \"libextutils-command-perl\", \"op\": \"<<\", \"version\": \"7.70\"}], [{\"name\": \"libextutils-install-perl\", \"op\": \"<<\", \"version\": \"2.22\"}], [{\"name\": \"libextutils-parsexs-perl\", \"op\": \"<<\", \"version\": \"3.510000\"}], [{\"name\": \"libfile-spec-perl\", \"op\": \"<<\", \"version\": \"3.9100\"}], [{\"name\": \"libhttp-tiny-perl\", \"op\": \"<<\", \"version\": \"0.088\"}], [{\"name\": \"libi18n-langtags-perl\", \"op\": \"<<\", \"version\": \"0.45\"}], [{\"name\": \"libio-zlib-perl\", \"op\": \"<<\", \"version\": \"1.15\"}], [{\"name\": \"libjson-pp-perl\", \"op\": \"<<\", \"version\": \"4.16000\"}], [{\"name\": \"liblocale-maketext-perl\", \"op\": \"<<\", \"version\": \"1.33\"}], [{\"name\": \"liblocale-maketext-simple-perl\", \"op\": \"<<\", \"version\": \"0.21.01\"}], [{\"name